# IR Limited — static React build on Apache / cPanel.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS (uncomment once SSL is active).
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Social-media link-preview crawlers do not run JavaScript: give them per-page
    # Open Graph tags from share.php. Regular visitors and search engines are unaffected.
    RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|Discordbot|Pinterestbot|SkypeUriPreview|redditbot|Embedly|vkShare) [NC]
    RewriteCond %{REQUEST_URI} !^/(assets|uploads)/
    RewriteCond %{REQUEST_URI} !\.(js|css|png|jpe?g|webp|gif|svg|ico|xml|txt|pdf|php)$ [NC]
    RewriteRule ^(.*)$ share.php?path=/$1 [L,QSA]

    # Serve existing files and folders directly (assets, sitemap.xml, robots.txt…).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else is a client-side route handled by React Router.
    RewriteRule ^ index.html [L]
</IfModule>

# Headers below apply only to requests for THIS website. Apache/LiteSpeed also apply
# this file to sub-folders, which on cPanel are often other sites' document roots
# (e.g. public_html/erp.example.com). The release script narrows the Host pattern
# to the real domain when it is known.
SetEnvIfNoCase Host ".*" IR_SITE

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff" env=IR_SITE
    Header always set X-Frame-Options "SAMEORIGIN" env=IR_SITE
    Header always set Referrer-Policy "strict-origin-when-cross-origin" env=IR_SITE
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()" env=IR_SITE

    # Hashed build assets never change → cache for a year. index.html must not be cached.
    <FilesMatch "\.(js|css|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable" env=IR_SITE
    </FilesMatch>
    <FilesMatch "index\.html$">
        Header set Cache-Control "no-cache, must-revalidate" env=IR_SITE
    </FilesMatch>
</IfModule>

# Compression. AddOutputFilterByType needs mod_filter; without the guard a host lacking
# it would answer every request with "500 Internal Server Error".
<IfModule mod_deflate.c>
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml
    </IfModule>
</IfModule>
