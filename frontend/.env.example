# Base URL of the Laravel API host, no trailing slash.
# Development: leave empty (Vite proxies /api, /sanctum and /uploads to Laravel).
# Production (API on a subdomain): VITE_API_URL=https://api.example.com
VITE_API_URL=

# Optional: where the Vite dev proxy forwards API calls (default http://127.0.0.1:8000).
# DEV_API_PROXY_TARGET=http://127.0.0.1:8000
