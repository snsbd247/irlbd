# =====================================================================
# IR Limited API — environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# On cPanel, .env must live OUTSIDE public_html (see CPANEL_DEPLOYMENT.md).
# =====================================================================

APP_NAME="IR Limited"
APP_ENV=production
# Generate with: php artisan key:generate --show   (paste the base64:... value here)
APP_KEY=
# MUST be false in production (prevents stack traces being shown).
APP_DEBUG=false
# Public URL of this API host (no trailing slash), e.g. https://api.example.com
APP_URL=https://api.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---------------------------------------------------------------- Database
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_irlbd
DB_USERNAME=cpaneluser_irlbd
DB_PASSWORD=change-me

# ---------------------------------------------------------------- Frontend / SPA auth
# Public website URL (used for CORS, sitemap links). No trailing slash.
FRONTEND_URL=https://example.com
# Comma-separated list of origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
# Hosts (no scheme) whose requests receive session cookies (Sanctum SPA auth).
SANCTUM_STATEFUL_DOMAINS=example.com,www.example.com
# Leading dot shares the session cookie between example.com and api.example.com.
SESSION_DOMAIN=.example.com
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/

# ---------------------------------------------------------------- Cache / queue (no cron/worker needed)
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---------------------------------------------------------------- Uploads
# Defaults to <public dir>/uploads. Override only if your web root differs.
# UPLOADS_ROOT=/home/cpaneluser/api.example.com/uploads
# UPLOADS_URL=https://api.example.com/uploads
UPLOAD_MAX_KB=5120
UPLOAD_MAX_DIMENSION=2000
# PDF brochures/datasheets (media library) and applicant CVs (stored privately).
UPLOAD_DOCUMENT_MAX_KB=15360
UPLOAD_CV_MAX_KB=5120

# Absolute path of the frontend web root, so "Regenerate sitemap" can write sitemap.xml there.
# SITEMAP_OUTPUT_PATH=/home/cpaneluser/public_html

# ---------------------------------------------------------------- Mail
# Used for enquiry/quote/job-application notifications, admin password-reset links
# and newsletters. Everything is still stored in the database if sending fails.
# On cPanel you can skip SMTP and send through the server's own mail system
# (no mailbox needed for a no-reply address):
#   MAIL_MAILER=sendmail
#   MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -t -i"
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.example.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=change-me
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Newsletter emails sent per click/request (1-100). Keep it low on shared hosting,
# where hosts often limit emails per hour.
NEWSLETTER_BATCH_SIZE=20

# ---------------------------------------------------------------- First admin (remove after install!)
ADMIN_NAME="Site Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set SEED_DEMO_CONTENT=false to skip demo products/news/clients on first install.
SEED_DEMO_CONTENT=true

# Optional: only these IPs / CIDR ranges can use the admin panel (comma separated).
# Leave empty to allow any network. Check your office IP at https://ifconfig.me first.
# ADMIN_ALLOWED_IPS=103.12.34.56,103.12.34.0/24

# One-time web installer for hosts WITHOUT SSH (POST /api/install). Use a random
# string of at least 32 characters, run the installer, then DELETE this value.
INSTALL_TOKEN=
